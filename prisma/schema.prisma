// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id          String @id @default(uuid())
  name        String 
  slug        String @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  //Relations
  members     TenantMember[] // 1:N one to many relationship
  boards      Board[]
  posts       Post[]
  comments    Comment[]
  apiKeys     ApiKey[]
}

model TenantMember {
  id          String @id @default(uuid())
  tenantId    String //relation scalar field act as foreign key
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)      

  clerkUserId String

  baseRole    String @default("MEMBER")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, clerkUserId])// Business constraint ensuring a Clerk user cannot be duplicated inside the same company
  @@index([tenantId]) // Essential index for optimizing Postgres Row-Level Security evaluation speeds
}


model Board {
  id        String @id @default(uuid())
  tenantId  String 
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  description String?
  isPrivate Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts     Post[]
  @@unique([tenantId, slug]) // Index optimization preventing horizontal data leaks during tenant RLS checks
  @@index([tenantId])
}

model Post {
  id      String @id @default(uuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  boardId   String
  board     Board @relation(fields: [boardId], references:[id], onDelete: Cascade)

  title     String
  description String
  status    String @default("OPEN")

  //who created it
  authorId  String
  authorName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  comments  Comment[]

  @@index([tenantId]) // Performance anchor for multi-tenant database partitioning checks
  @@index([boardId]) // Index designed to fast-track board loading operations on public end-user portals

}


model Comment {
  id    String @id @default(uuid())
  tenantId String
  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  postId  String
  post    Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId  String
  authorName  String?
  content   String
  isInternal  Boolean @default(false) // Flags team-only commentary notes hidden entirely from the public-facing user base
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId]) // Guarantees fast access speeds during multitenant multi-tenant connection queries
  @@index([postId]) // Accelerates loading speeds when building interactive public user discussion boards
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@index([tenantId]) // Fast lookups when authenticating requests!
}